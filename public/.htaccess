RewriteEngine On

# Pretty status redirect endpoints
RewriteRule ^301/?$ /status_301.php [L]
RewriteRule ^302/?$ /status_302.php [L]

# Keep existing files/directories working
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Any unknown path -> real 404 page
ErrorDocument 404 /status_404.php
