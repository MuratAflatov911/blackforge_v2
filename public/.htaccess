RewriteEngine On

# Pretty status redirect endpoints
RewriteRule ^301/?$ /status_301.php [L]
RewriteRule ^302/?$ /status_302.php [L]

# Existing files/directories
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Unknown routes -> 404
RewriteRule . - [R=404,L]
ErrorDocument 404 /status_404.php
